{
  "version": 2,
  "buildCommand": "npx prisma generate && npx vite build && npx esbuild src/server/vercel-entry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*": {
      "memory": 1024,
      "maxDuration": 30,
      "includeFiles": "node_modules/.prisma/client/**"
    }
  },
  "rewrites": [
    {
      "source": "/portal/:token",
      "destination": "/portal.html"
    },
    {
      "source": "/api/ping",
      "destination": "/api/ping"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|portal/).*)",
      "destination": "/index.html"
    }
  ]
}
